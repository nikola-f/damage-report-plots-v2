#!/usr/bin/env bash
set -euo pipefail

# Run e2e specs using credentials stored in Bitwarden.
#
# Prerequisites:
#   brew install bitwarden-cli
#   bw login
#   bw unlock  # sets BW_SESSION
#
# Bitwarden items (type: Login, store secret in Password field):
#   drp-e2e-refresh-token     -> GOOGLE_TEST_REFRESH_TOKEN
#   drp-e2e-client-id         -> GOOGLE_CLIENT_ID
#   drp-e2e-client-secret     -> GOOGLE_CLIENT_SECRET
#   drp-e2e-spreadsheet-id    -> GOOGLE_TEST_SPREADSHEET_ID (optional; auto-created on first run)
#
# Local services required before running:
#   docker run -d -p 4566:4566 localstack/localstack:3
#   AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test \
#     aws --endpoint-url=http://localhost:4566 --region us-east-1 sqs create-queue \
#     --queue-name test-report-queue.fifo \
#     --attributes FifoQueue=true,ContentBasedDeduplication=false
#   AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test \
#     aws --endpoint-url=http://localhost:4566 --region us-east-1 sqs create-queue \
#     --queue-name test-reports-queue.fifo \
#     --attributes FifoQueue=true,ContentBasedDeduplication=false
#   docker run -d -p 6380:6379 valkey/valkey
#
# Usage:
#   export BW_SESSION=$(bw unlock --raw)
#   bin/e2e

BW_SESSION="${BW_SESSION:?BW_SESSION is not set. Run: export BW_SESSION=\$(bw unlock --raw)}"

fetch() {
  bw get password "$1" --session "$BW_SESSION"
}

exec env \
  GOOGLE_TEST_REFRESH_TOKEN="$(fetch drp-e2e-refresh-token)" \
  GOOGLE_CLIENT_ID="$(fetch drp-e2e-client-id)" \
  GOOGLE_CLIENT_SECRET="$(fetch drp-e2e-client-secret)" \
  GOOGLE_TEST_SPREADSHEET_ID="$(fetch drp-e2e-spreadsheet-id 2>/dev/null || true)" \
  AWS_ACCESS_KEY_ID=test \
  AWS_SECRET_ACCESS_KEY=test \
  AWS_DEFAULT_REGION=us-east-1 \
  AWS_ENDPOINT_URL=http://localhost:4566 \
  SETTINGS__SQS_THREAD_IDS_QUEUE_URL=http://localhost:4566/000000000000/test-report-queue.fifo \
  SETTINGS__SQS_REPORTS_QUEUE_URL=http://localhost:4566/000000000000/test-reports-queue.fifo \
  SETTINGS__REDIS_URL=redis://localhost:6380/0 \
  bundle exec rspec spec/e2e "$@"
